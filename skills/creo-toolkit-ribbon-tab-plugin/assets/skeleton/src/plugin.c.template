#include <ProToolkit.h>
#include <ProUICmd.h>
#include <ProRibbon.h>
#include <ProMessage.h>

static ProFileName g_msg_file = L"{{MESSAGE_FILE}}";

static uiCmdAccessState plugin_access(uiCmdAccessMode mode)
{
    (void)mode;
    return ACCESS_AVAILABLE;
}

static int command_action(uiCmdCmdId command, uiCmdValue *value, void *data)
{
    (void)command;
    (void)value;
    (void)data;
    (void)ProMessageDisplay(g_msg_file, "{{RUN_MESSAGE_KEY}}");
    return 0;
}

__declspec(dllexport) int user_initialize(
    int argc,
    char *argv[],
    char *version,
    char *build,
    wchar_t errbuf[80])
{
    uiCmdCmdId command_id = NULL;
    ProError err;
    ProError icon_err;
    ProError designate_err;
    ProError ribbon_err;

    (void)argc;
    (void)argv;
    (void)version;
    (void)build;
    if (errbuf != NULL)
        errbuf[0] = L'\0';

    err = ProCmdActionAdd(
        "{{COMMAND_NAME}}",
        command_action,
        uiProe2ndImmediate,
        plugin_access,
        PRO_B_TRUE,
        PRO_B_TRUE,
        &command_id);
    if (err == PRO_TK_E_FOUND)
        err = ProCmdCmdIdFind("{{COMMAND_NAME}}", &command_id);
    if (err != PRO_TK_NO_ERROR)
        return (int)err;

    icon_err = ProCmdIconSet(command_id, "{{ICON_NAME}}");
    if (icon_err != PRO_TK_NO_ERROR)
        return (int)icon_err;

    designate_err = ProCmdDesignate(
        command_id,
        "{{COMMAND_LABEL_KEY}}",
        "{{COMMAND_HELP_KEY}}",
        "{{COMMAND_DESC_KEY}}",
        g_msg_file);
    if (designate_err != PRO_TK_NO_ERROR)
        return (int)designate_err;

    /* Commands must exist before this call. The .rbn is generated by Creo. */
    ribbon_err = ProRibbonDefinitionfileLoad(L"toolkitribbonui.rbn");
    if (ribbon_err != PRO_TK_NO_ERROR && ribbon_err != PRO_TK_E_IN_USE)
        return (int)ribbon_err;
    return PRO_TK_NO_ERROR;
}

__declspec(dllexport) void user_terminate(void)
{
}
